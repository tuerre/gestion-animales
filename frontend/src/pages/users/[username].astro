---
import Layout from "@/layouts/Layout.astro";
import AnimalCard from "../../components/AnimalCard.astro";

const { username } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_URL;

const res = await fetch(`${apiUrl}/users/${username}`, { credentials: "include" });
if (!res.ok) {
  throw new Error("Usuario no encontrado");
}
const { user, animals } = await res.json();
const title = `${user.name} (@${user.username}) - LunarPaws`;
---

<Layout title={title}>
  <main class="max-w-7xl mx-auto py-10">
    <section class="relative flex items-center justify-center gap-4 mb-8 bg-[#181818a8] border border-[#2d2d2d] p-6 rounded-2xl shadow-lg">
      <div class="w-full max-w-lg rounded-2xl p-8 flex flex-col gap-6 items-center">
        <img
          src={user.avatar_url}
          alt={user.username}
          class="select-none size-44 rounded-full border border-gray-600" />
        <div class="text-center">
          <h1 class="text-3xl whitespace-nowrap font-bold">{user.name || user.username}</h1>
          <p class="text-gray-400 text-base">@{user.username}</p>
        </div>
      </div>

      <div id="shareProfile" class="absolute top-0 right-0 m-3 cursor-pointer p-2 rounded-full bg-gray-900 hover:bg-gray-800/80 transition" title="Compartir perfil"> 
        <div data-username={user.username} id="shareProfile-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 48 48" class="w-7 h-7">
            <path d="M35.274 15.838H31.18a1.5 1.5 0 1 0 0 3h4.095c.827 0 1.5.673 1.5 1.5v19.616c0 .827-.673 1.5-1.5 1.5H12.726c-.827 0-1.5-.673-1.5-1.5V20.338c0-.827.673-1.5 1.5-1.5h4.095a1.5 1.5 0 1 0 0-3h-4.095a4.505 4.505 0 0 0-4.5 4.5v19.616c0 2.481 2.019 4.5 4.5 4.5h22.549c2.481 0 4.5-2.019 4.5-4.5V20.338a4.506 4.506 0 0 0-4.501-4.5zM18.407 12.81l4.143-4.143v19.748a1.5 1.5 0 1 0 3 0V8.667l4.143 4.143c.293.293.677.439 1.061.439s.768-.146 1.061-.439a1.5 1.5 0 0 0 0-2.121l-6.703-6.704a1.5 1.5 0 0 0-2.122 0l-6.704 6.704a1.5 1.5 0 1 0 2.121 2.121z" fill="#ffffff"/>
          </svg>
        </div>
      </div>
    </section>

    <section class="relative flex items-center justify-center gap-4 mb-8 bg-[#181818a8] border border-[#2d2d2d] p-6 rounded-2xl shadow-lg">
      {animals.length === 0 ? (
        <div class="flex flex-col gap-4 items-center justify-center">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-26 h-26 text-[#211c29]"><path d="M9.33333 19.7435C7.75238 20.0082 6.15473 20.0683 4.58027 19.9226C4.44521 19.9101 4.32574 19.8519 4.23691 19.7631C4.14808 19.6743 4.08989 19.5548 4.0774 19.4197C3.93174 17.8453 3.99179 16.2476 4.25652 14.6667M14.6667 19.7435C16.2476 20.0082 17.8453 20.0683 19.4197 19.9226C19.5548 19.9101 19.6743 19.8519 19.7631 19.7631C19.8519 19.6743 19.9101 19.5548 19.9226 19.4197C20.0683 17.8453 20.0082 16.2476 19.7435 14.6667M4.25652 9.33333C3.99179 7.75238 3.93174 6.15473 4.0774 4.58027C4.08989 4.44521 4.14808 4.32574 4.23691 4.23691C4.32574 4.14808 4.44521 4.08989 4.58027 4.0774C6.15473 3.93174 7.75238 3.99179 9.33333 4.25652M14.6667 4.25652C16.2476 3.99179 17.8453 3.93174 19.4197 4.0774C19.5548 4.08989 19.6743 4.14808 19.7631 4.23691C19.8519 4.32574 19.9101 4.44521 19.9226 4.58027C20.0683 6.15473 20.0082 7.75238 19.7435 9.33333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <h4 class="font-semibold text-[20px]">No Posts</h4>
          <span class="text-[#888888] font-medium">This user has no public animals.</span>
        </div>
      ) : (
        <div class="w-full max-w-4xl">
          {animals.map((animal: any) => (
              <AnimalCard username={user.username} name={user.name} userAvatarUrl={user.avatar_url} animalName={animal.name} animalAge={animal.age} animal_photo_url={animal.animal_photo_url} created_at={animal.created_at} />
          ))}
        </div>
      )}

    </section>
  </main>
</Layout>

<script type="module">
  const shareButton = document.getElementById('shareProfile-button');
  const shareProfileDiv = document.getElementById('shareProfile');

  function updateShareButtonCopied() {
    const icon = `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 511.985 511.985" class="w-7 h-7">
                    <path d="M500.088 83.681c-15.841-15.862-41.564-15.852-57.426 0L184.205 342.148 69.332 227.276c-15.862-15.862-41.574-15.862-57.436 0-15.862 15.862-15.862 41.574 0 57.436l143.585 143.585c7.926 7.926 18.319 11.899 28.713 11.899 10.394 0 20.797-3.963 28.723-11.899l287.171-287.181c15.862-15.851 15.862-41.574 0-57.435z" fill="#69cb41"/>
                  </svg>`;
    shareProfileDiv?.classList.add('bg-green-600');
    shareProfileDiv?.classList.remove('bg-gray-900');
    shareButton.innerHTML = icon;
  }

  function updateShareButtonDefault() {
    const icon = `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 48 48" class="w-7 h-7">
                    <path d="M35.274 15.838H31.18a1.5 1.5 0 1 0 0 3h4.095c.827 0 1.5.673 1.5 1.5v19.616c0 .827-.673 1.5-1.5 1.5H12.726c-.827 0-1.5-.673-1.5-1.5V20.338c0-.827.673-1.5 1.5-1.5h4.095a1.5 1.5 0 1 0 0-3h-4.095a4.505 4.505 0 0 0-4.5 4.5v19.616c0 2.481 2.019 4.5 4.5 4.5h22.549c2.481 0 4.5-2.019 4.5-4.5V20.338a4.506 4.506 0 0 0-4.501-4.5zM18.407 12.81l4.143-4.143v19.748a1.5 1.5 0 1 0 3 0V8.667l4.143 4.143c.293.293.677.439 1.061.439s.768-.146 1.061-.439a1.5 1.5 0 0 0 0-2.121l-6.703-6.704a1.5 1.5 0 0 0-2.122 0l-6.704 6.704a1.5 1.5 0 1 0 2.121 2.121z" fill="#ffffff"/>
                  </svg>`;
    shareProfileDiv?.classList.add('bg-gray-900');
    shareProfileDiv?.classList.remove('bg-green-600');
    shareButton.innerHTML = icon;
  }

  shareButton?.addEventListener('click', async () => {
    const username = shareButton?.getAttribute('data-username');
    if (!username) return;

    const profileUrl = `${window.location.origin}/users/${username}`;

    try {
      await navigator.clipboard.writeText(profileUrl);
      updateShareButtonCopied();
      setTimeout(updateShareButtonDefault, 2000);
    } catch (err) {
      console.error('Error al copiar al portapapeles: ', err);
      alert(`No se pudo copiar el enlace. Por favor, cópialo manualmente: ${profileUrl}`);
    }
  });
</script>
