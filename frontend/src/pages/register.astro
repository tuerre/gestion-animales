---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LunarPaws | Register">
    <main class="flex justify-center items-center h-screen">
        <div class="w-full max-w-md bg-[#060010] border border-[#271f32] rounded-2xl shadow-lg p-8">
            <h1 class="text-2xl font-semibold mb-6">Crear cuenta</h1>
      
            <form id="registerForm" class="space-y-4" autocomplete="on">
              <div>
                <label for="username" class="block text-sm font-medium mb-1"
                  >Usuario</label
                >
                <input
                  id="username"
                  name="username"
                  type="text"
                  required
                  class="w-full px-4 py-2 border border-[#271f32] rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-200"
                />
              </div>
      
              <div>
                <label for="name" class="block text-sm font-medium mb-1">Nombre</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  class="w-full px-4 py-2 border border-[#271f32] rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-200"
                />
              </div>
      
              <div>
                <label
                  for="email"
                  class="block text-sm font-medium mb-1"
                  >Correo electrónico</label
                >
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="w-full px-4 py-2 border border-[#271f32] rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-200"
                />
              </div>
      
              <div>
                <label
                  for="password"
                  class="block text-sm font-medium mb-1"
                  >Contraseña</label
                >
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  minlength="8"
                  class="w-full px-4 py-2 border border-[#271f32] rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-200"
                />
              </div>
      
              <button
                id="submitBtn"
                type="submit"
                class="w-full py-3 cursor-pointer bg-[#271f32] rounded-lg font-medium disabled:opacity-60"
              > Registrarme</button>
                <p class="text-sm mt-2">¿Ya tienes una cuenta? <a href="/login" class="text-[#3ECF8E] font-medium">Iniciar sesión</a></p>
                <p id="message" class="text-sm mt-2" aria-live="polite"></p>
            </form>
        </div>
    </main>
  
      <script type="module">
        const form = document.getElementById("registerForm");
        const messageEl = document.getElementById("message");
        const submitBtn = document.getElementById("submitBtn");
  
        function showError(msg) {
          messageEl.textContent = msg;
          messageEl.classList.remove("text-green-600");
          messageEl.classList.add("text-red-600");
        }
  
        function showSuccess(msg) {
          messageEl.textContent = msg;
          messageEl.classList.remove("text-red-600");
          messageEl.classList.add("text-green-600");
        }
  
        async function handleSubmit(e) {
          e.preventDefault();
          messageEl.textContent = "";
  
          const formData = new FormData(form);
          const payload = {
            username: formData.get("username").trim(),
            name: formData.get("name").trim(),
            email: formData.get("email").trim().toLowerCase(),
            password: formData.get("password"),
          };
  
          if (!payload.username || !payload.name || !payload.email || !payload.password) {
            return showError("Todos los campos son obligatorios.");
          }
  
          submitBtn.disabled = true;
          const originalText = submitBtn.textContent;
          submitBtn.textContent = "Registrando...";
  
          try {
            const res = await fetch("http://localhost:4000/auth/register", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              credentials: "include",
              body: JSON.stringify(payload),
            });
  
            const data = await res.json().catch(() => ({}));
  
            if (!res.ok) {
              showError(data?.Error || data?.msg || "Error en el registro.");
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
              return;
            }
  
            showSuccess("Registro exitoso 🎉 Redirigiendo...");
            setTimeout(() => {
              window.location.href = "/login";
            }, 1500);
          } catch (err) {
            console.error(err);
            showError("Error de red o backend caído.");
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
        }
  
        form.addEventListener("submit", handleSubmit);
      </script>
</Layout>
