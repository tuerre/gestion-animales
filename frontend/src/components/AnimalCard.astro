---
const { username, name, userAvatarUrl, animalName, animalAge, animal_photo_url, created_at } = Astro.props
---

<article>
        <div class="flex justify-between items-center">
            <div class="flex flex-col gap-4">
                <div class="flex gap-2 items-center ">
                    <img src={userAvatarUrl} alt="{username}" class="w-11 h-11 rounded-full select-none" />
                    <div class="flex gap-1.5">
                        <span class="font-bold">{username}</span>
                        <span class="text-[#f3f5f78a]">{created_at}</span>
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                        <span>{animalName} - {animalAge}</span>
                        <img id="animalPhoto" src={animal_photo_url} alt={animalName} class="max-w-full max-h-64 rounded-2xl" />
                </div>
            </div>
            <div>
                <div class="flex gap-1 items-center justify-center">
                    <button id="like-animal">
                    <svg 
                        aria-label="Like"
                        class="w-6 h-6 cursor-pointer hover:opacity-70 transition-opacity" 
                        fill="none"
                        viewBox="0 0 18 18">
                            <title>Like</title>
                        <path d="M1.34375 7.53125L1.34375 7.54043C1.34374 8.04211 1.34372 8.76295 1.6611 9.65585C1.9795 10.5516 2.60026 11.5779 3.77681 12.7544C5.59273 14.5704 7.58105 16.0215 8.33387 16.5497C8.73525 16.8313 9.26573 16.8313 9.66705 16.5496C10.4197 16.0213 12.4074 14.5703 14.2232 12.7544C15.3997 11.5779 16.0205 10.5516 16.3389 9.65585C16.6563 8.76296 16.6563 8.04211 16.6562 7.54043V7.53125C16.6562 5.23466 15.0849 3.25 12.6562 3.25C11.5214 3.25 10.6433 3.78244 9.99228 4.45476C9.59009 4.87012 9.26356 5.3491 9 5.81533C8.73645 5.3491 8.40991 4.87012 8.00772 4.45476C7.35672 3.78244 6.47861 3.25 5.34375 3.25C2.9151 3.25 1.34375 5.23466 1.34375 7.53125Z"
                            fill="none" 
                            stroke="#FFFFFF" 
                            stroke-width="1.25">
                        </path>
                    </svg>
                    </button>
                    <span id="like-count" class="text-gray-300 select-none">0</span>
                </div>
            </div>
        </div>
        <div class="h-[1px] w-full my-4 bg-gray-500/50"></div>
</article>
