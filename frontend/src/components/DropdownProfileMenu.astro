<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("profile-button");
    const menu = document.getElementById("profile-menu");
    const logoutBtn = document.getElementById("logout");

    if (btn) {
      btn.addEventListener("click", (e) => {
        console.log("click en perfil");
        menu.classList.toggle("hidden");
      });
    } else {
      console.log("El botón de perfil no se encuentra.");
    }

    document.addEventListener("click", (e) => {
      if (menu && !menu.contains(e.target) && btn && !btn.contains(e.target)) {
        console.log("Cerrando el menú porque se hizo clic fuera.");
        menu.classList.add("hidden");
      }
    });

    if (logoutBtn) {
      logoutBtn.addEventListener("click", async () => {
        try {
          const res = await fetch("http://localhost:4000/auth/logout", {
            method: "POST",
            credentials: "include",
          });

          if (!res.ok) {
            throw new Error("Error cerrando sesión");
          }

          window.location.href = "/login";
        } catch (err) {
          console.error("Error cerrando sesión:", err);
        }
      });
    }
  });

  async function getAndShowEmail() {
        try {
            const res = await fetch("http://localhost:4000/auth/status", {
                credentials: "include",
            });

            if (!res.ok) {
                return { isLoggedIn: false, user: null };
            }

            const data = await res.json();
            const userEmail = document.getElementById("user-email");
            userEmail.textContent = data.user.email;
            return;
        } catch (err) {
            console.error("Error verificando sesión. Iniciando sesión como invitado.");
            return;
        }
    }

    getAndShowEmail();
</script>
