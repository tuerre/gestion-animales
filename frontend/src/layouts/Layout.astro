---
import Navbar from "@/components/Navbar.astro";
import "../styles/global.css";

interface Props {
  title: string,
  showNavbar?: boolean
}

const { title = "LunarPaws | Gestion de animales" } = Astro.props
const {showNavbar = true} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name='description' content='Gestiona y descubre animales bajo la luz de la luna. Navega por perfiles y conoce animales de personas de cualquier parte del mundo.' />
    	<meta name='viewport' content='width=device-width' />
    	<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    	<meta name='theme-color' content='#121212' />
    	<meta name='og:title' content={title} />
    	<meta name='og:description' content='Gestiona y descubre animales bajo la luz de la luna. Navega por perfiles y conoce animales de personas de cualquier parte del mundo.'/>
    	<meta name='og:image' content='/og.jpg' />
    	<meta name='twitter:card' content='summary_large_image' />
    	<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
	</head>
	<body>
		{showNavbar && <Navbar />}
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #060010;
		color: #FAFAFA;
		font-family: 'Figtree', sans-serif;
	}
</style>
